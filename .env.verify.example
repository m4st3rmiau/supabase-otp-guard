# Variables for scripts/verify.mjs and scripts/e2e-mobile.mjs. Copy to .env.verify
# (git-ignored) and run:  node --env-file=.env.verify scripts/verify.mjs

# Dashboard -> Project Settings -> API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: enables the Auth config checks. https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
