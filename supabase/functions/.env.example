# Edge Function secrets. Copy to supabase/functions/.env (git-ignored) and upload with:
#   supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase:
# do not add them here (the CLI refuses names starting with SUPABASE_).

# --- Auth hooks --------------------------------------------------------------------------
# Dashboard -> Authentication -> Hooks. Enable each one as HTTPS, point it at the URL
# below, click "Generate secret" and paste the value (v1,whsec_...).
#   Send SMS:            https://<project-ref>.supabase.co/functions/v1/send-sms-hook
#   Before User Created: https://<project-ref>.supabase.co/functions/v1/before-user-created-hook
SEND_SMS_HOOK_SECRET=v1,whsec_REPLACE_ME
BEFORE_USER_CREATED_HOOK_SECRET=v1,whsec_REPLACE_ME

# --- otp-gateway -------------------------------------------------------------------------
# Web origins allowed to call the gateway. Empty refuses every web request.
OTP_GUARD_ALLOWED_ORIGINS=https://app.example.com,http://localhost:3000

# "turnstile" (default) or "off". Cloudflare's test secret 1x0000000000000000000000000000000AA
# always passes but reports its own hostname: allow it in OTP_GUARD_TURNSTILE_HOSTNAMES
# while testing, and use a real widget in production.
OTP_GUARD_WEB_CAPTCHA=turnstile
TURNSTILE_SECRET_KEY=REPLACE_ME
# OTP_GUARD_TURNSTILE_HOSTNAMES=app.example.com,localhost
# OTP_GUARD_TURNSTILE_ACTIONS=login,signup

# Web-only project: refuse the mobile path (it has no captcha).
# OTP_GUARD_MOBILE=off

# Only while running scripts/verify.mjs; unset afterwards.
# OTP_GUARD_DIAGNOSTICS=true

# --- Bird ----------------------------------------------------------------------------------
# Bird dashboard -> Settings -> API access. The key prefix is the region: bk_us1_... -> us1
BIRD_API_KEY=bk_REPLACE_ME
BIRD_REGION=us1

# "sms" uses Bird's built-in template (English copy). "whatsapp" needs an approved
# authentication template in the workspace.
BIRD_CHANNEL=sms
# BIRD_SMS_TEMPLATE=bird_otp_verification_ttl
# BIRD_SMS_LANGUAGE=en
# Keep in sync with Authentication -> Providers -> Phone -> OTP expiry (minutes).
# BIRD_SMS_TTL_MINUTES=5
# BIRD_WHATSAPP_TEMPLATE=bird_otp
# BIRD_WHATSAPP_LANGUAGE=es
